# ===== Baho Tech Backend — Environment Template =====
# Copy this file to .env (development) or .env.production (production).
# Never commit real secret values.

NODE_ENV=development
HOST=127.0.0.1
PORT=3001

# Public server URL (backend)
SERVER_URL=http://localhost:3001

# MongoDB connection string
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/REPLACE_WITH_DB_NAME

# Allowed frontend origins (comma separated, exact match)
CLIENT_ORIGIN=http://localhost:5173
CLIENT_ORIGINS=http://localhost:5173,http://localhost:5174

# JWT secrets — must be different values and at least 16 characters
JWT_SECRET=replace_with_a_long_random_secret
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret

# Access tokens and refresh tokens
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Initial admin account
ADMIN_NAME=Baho Tech Admin
ADMIN_EMAIL=admin@bahotech.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Gmail SMTP for real email delivery
# 1. Enable 2FA on your Gmail account
# 2. Generate an App Password from Google Account > Security
# 3. Use that app password below
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=youraccount@gmail.com
SMTP_PASS=your-16-character-gmail-app-password
SMTP_FROM=youraccount@gmail.com
SMTP_TO=admin@bahotech.com

# Gemini AI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite
GEMINI_CACHE_TTL_SECONDS=3600
GEMINI_MAX_CACHE_ENTRIES=500
GEMINI_MAX_RETRIES=2
GEMINI_RETRY_MAX_DELAY_MS=8000